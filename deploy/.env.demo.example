# ---------------------------------------------------------------------------
# EMSafe — variables para el perfil DEMO (sustentaciones).
#
#   cp .env.demo.example .env.demo   y rellena los valores reales.
#
# El .env.demo NUNCA se commitea (está en el .gitignore). Esta plantilla sí.
# ---------------------------------------------------------------------------

# --- Base de datos: TiDB Cloud Serverless -----------------------------------
# Copia estos datos desde el panel de TiDB Cloud → "Connect".
# IMPORTANTE: TiDB exige TLS → la URL lleva sslMode=REQUIRED (NO useSSL=true).
MYSQL_URL=jdbc:mysql://gateway01.us-west-2.prod.aws.tidbcloud.com:4000/emsafe_db?sslMode=REQUIRED&serverTimezone=UTC&allowPublicKeyRetrieval=true&characterEncoding=UTF-8
MYSQL_USER=TU_USUARIO_TIDB
MYSQL_PASSWORD=TU_PASSWORD_TIDB

# --- Seguridad de la aplicación ---------------------------------------------
# Mínimo 32 bytes. Genera con:  openssl rand -base64 48
JWT_SECRET=CAMBIAME_jwt

# --- CORS: origen del front en Vercel ---------------------------------------
# Sin barra final. Es EXACTAMENTE la URL que te da Vercel.
# Puedes poner varios separados por coma (útil para probar en local a la vez).
CORS_ALLOWED_ORIGINS=https://emsafe-admin.vercel.app,http://localhost:4200

# --- URL pública del backend (el túnel ngrok) -------------------------------
# La usa Swagger para mostrar el servidor "Producción" sin localhost.
APP_PUBLIC_URL=https://emsafe.ngrok-free.app

# --- Integraciones ----------------------------------------------------------
# Chatbot "Astra". Google AI Studio → Get API key. Vacío = chat desactivado.
GEMINI_API_KEY=
