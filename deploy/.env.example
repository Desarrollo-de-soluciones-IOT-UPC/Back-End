# ---------------------------------------------------------------------------
# EMSafe — variables de producción.
#
#   cp .env.example .env   y rellena los valores reales.
#
# El .env NUNCA se commitea (está en el .gitignore). Este .env.example sí,
# pero solo con placeholders.
# ---------------------------------------------------------------------------

# --- Dominio y certificado --------------------------------------------------
# Sin https:// ni barra final.
DOMAIN=emsafe.duckdns.org

# Let's Encrypt avisa aquí si un certificado está por vencer sin renovarse.
ACME_EMAIL=tu-correo@gmail.com

# --- Base de datos ----------------------------------------------------------
# Genera cada una con:  openssl rand -base64 24
MYSQL_ROOT_PASSWORD=CAMBIAME_root
MYSQL_DATABASE=emsafe_db
MYSQL_USER=emsafe
MYSQL_PASSWORD=CAMBIAME_app

# --- Seguridad de la aplicación ---------------------------------------------
# Mínimo 32 bytes. Genera con:  openssl rand -base64 48
# Al cambiarlo se invalidan todos los tokens emitidos (todos deben reloguear).
JWT_SECRET=CAMBIAME_jwt

# --- Integraciones ----------------------------------------------------------
# Chatbot "Astra". Google AI Studio -> Get API key. Déjalo vacío para
# desactivar el chat sin romper el resto de la aplicación.
GEMINI_API_KEY=

# --- DuckDNS ----------------------------------------------------------------
# Solo lo usa el cron que refresca la IP. Token en https://www.duckdns.org
DUCKDNS_SUBDOMAIN=emsafe
DUCKDNS_TOKEN=CAMBIAME_token
